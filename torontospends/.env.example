# Copy to .env and fill in. Never commit the real .env.
#
# Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler"
# for most deployment targets; see Supabase's own docs for which mode fits Render).
DATABASE_URL=postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres

DJANGO_SECRET_KEY=change-me-to-a-random-value-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-app.onrender.com,yourdomain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://yourdomain.example
